{
  "mcpServers": {
    "reqable": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "reqable-mcp-server"]
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--no-usage-statistics",
        "--no-performance-crux"
      ]
    }
  }
}
